# Copy to .env to override any default (all optional).

# Path to the trained weights. Default: ../best_model (1).pt (the file in the project root).
# MODEL_PATH=../best_model (1).pt

# auto | cpu | cuda
# DEVICE=auto

# A clip counts as an anomaly when its score >= this. NOT defined by the training
# notebook -- 0.5 is an untuned starting point; calibrate it on your own footage.
# ANOMALY_THRESHOLD=0.5

# Live feed: score a new clip every N received frames (16 = non-overlapping clips)
# LIVE_CLIP_STRIDE=16

# MAX_UPLOAD_MB=500
CORS_ORIGINS=http://localhost:5173
